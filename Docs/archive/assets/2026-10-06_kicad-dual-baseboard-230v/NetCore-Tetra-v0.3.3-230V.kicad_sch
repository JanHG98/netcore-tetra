    (effects (font (size 1.6256 1.6256)) (justify left))
    (uuid "ff852225-a0ea-5847-b126-108effd828a8")
  )
  (text "GPIO5/reset is an intentional exception: OR with supervisor inhibit, active HIGH. MCU absent -> SDR held in reset."
