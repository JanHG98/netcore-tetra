    (effects (font (size 1.6256 1.6256)) (justify left))
    (uuid "0b105e48-ac03-5edb-9b39-76d153c2bf60")
  )
  (text "Signals are NOT shared between the Pis. All pass-through conductors stay local; header orientation must match stack mechanics."
