    (effects (font (size 1.524 1.524)) (justify left))
    (uuid "efce45d0-60e5-525e-8ed6-e7ac460c03e9")
  )
  (text "Address plan in docs/INTERFACES.md. Channels 5..7 pins intentionally unused, not placeholder devices."
