# NETCORE-KOMMENTAR – Was: Enthält die Logik oder Einstellungen für netcore piper.
# NETCORE-KOMMENTAR – Warum: Die Trennung in eine eigene Datei macht Zuständigkeit, Wartung und Fehlersuche übersichtlicher.

# Was: Beginnt den Abschnitt `Unit`.
# Warum: Zusammengehörige Start-, Laufzeit- oder Installationswerte bleiben dadurch geordnet.
[Unit]
# Was: Beschreibt den Dienst für systemd und Administratoren.
# Warum: Statusausgaben zeigen dadurch sofort, wofür die Einheit zuständig ist.
Description=NetCore Media Library Piper TTS provider
# Was: Legt die Startreihenfolge gegenüber anderen Einheiten fest.
# Warum: Abhängige Netzwerk- oder Systemfunktionen müssen zuerst verfügbar sein.
After=network.target
# Was: Legt fest, welche Einheit erst nach dieser starten soll.
# Warum: Die benötigte Grundlage wird dadurch rechtzeitig bereitgestellt.
Before=netcore-media-library.service

# Was: Beginnt den Abschnitt `Service`.
# Warum: Zusammengehörige Start-, Laufzeit- oder Installationswerte bleiben dadurch geordnet.
[Service]
# Was: Legt fest, wie systemd den Startzustand des Prozesses bewertet.
# Warum: Systemd kann dadurch korrekt erkennen, wann die Einheit als gestartet gilt.
Type=simple
# Was: Legt das Betriebssystemkonto des Dienstes fest.
# Warum: Der Prozess erhält dadurch nur die vorgesehenen Dateirechte und Berechtigungen.
User=netcore-media-library
# Was: Legt die Betriebssystemgruppe des Dienstes fest.
# Warum: Gemeinsam benötigte Ressourcen können dadurch kontrolliert freigegeben werden.
Group=netcore-media-library
# Was: Legt das Arbeitsverzeichnis des Prozesses fest.
# Warum: Relative Pfade werden dadurch immer vom erwarteten Ort aus aufgelöst.
WorkingDirectory=/var/lib/netcore-media-library/piper
# Was: Übergibt eine Umgebungsvariable an den Dienst.
# Warum: Laufzeiteinstellungen bleiben dadurch außerhalb der Binärdatei konfigurierbar.
Environment=HOME=/var/lib/netcore-media-library/piper
# Was: Übergibt eine Umgebungsvariable an den Dienst.
# Warum: Laufzeiteinstellungen bleiben dadurch außerhalb der Binärdatei konfigurierbar.
Environment=PYTHONUNBUFFERED=1
# Was: Legt den eigentlichen Startbefehl des Dienstes fest.
# Warum: Systemd kann den Prozess dadurch mit einem eindeutigen und reproduzierbaren Kommando starten.
ExecStart=/opt/netcore-piper/bin/python -m piper.http_server -m de_DE-thorsten-medium --data-dir /var/lib/netcore-media-library/piper --host 127.0.0.1 --port 5005
# Was: Bestimmt das Neustartverhalten nach einem Prozessende.
# Warum: Der Dienst kann sich dadurch entsprechend seiner Betriebsanforderung selbst erholen.
Restart=on-failure
# Was: Legt die Wartezeit vor einem Neustart fest.
# Warum: Eine kurze Pause verhindert schnelle Endlosschleifen bei dauerhaftem Fehler.
RestartSec=3
# Was: Setzt `TimeoutStopSec` im Abschnitt `Service`.
# Warum: Der Wert wird ausdrücklich festgelegt, damit der Dienst auf jedem System gleich und nachvollziehbar arbeitet.
TimeoutStopSec=15
# Was: Setzt `NoNewPrivileges` im Abschnitt `Service`.
# Warum: Der Wert wird ausdrücklich festgelegt, damit der Dienst auf jedem System gleich und nachvollziehbar arbeitet.
NoNewPrivileges=true
# Was: Setzt `PrivateTmp` im Abschnitt `Service`.
# Warum: Der Wert wird ausdrücklich festgelegt, damit der Dienst auf jedem System gleich und nachvollziehbar arbeitet.
PrivateTmp=true
# Was: Setzt `ProtectSystem` im Abschnitt `Service`.
# Warum: Der Wert wird ausdrücklich festgelegt, damit der Dienst auf jedem System gleich und nachvollziehbar arbeitet.
ProtectSystem=strict
# Was: Setzt `ProtectHome` im Abschnitt `Service`.
# Warum: Der Wert wird ausdrücklich festgelegt, damit der Dienst auf jedem System gleich und nachvollziehbar arbeitet.
ProtectHome=true
# Was: Setzt `ReadWritePaths` im Abschnitt `Service`.
# Warum: Der Wert wird ausdrücklich festgelegt, damit der Dienst auf jedem System gleich und nachvollziehbar arbeitet.
ReadWritePaths=/var/lib/netcore-media-library/piper /var/lib/netcore-media-library/tts/cache

# Was: Beginnt den Abschnitt `Install`.
# Warum: Zusammengehörige Start-, Laufzeit- oder Installationswerte bleiben dadurch geordnet.
[Install]
# Was: Legt fest, an welches systemd-Ziel die Einheit bei Aktivierung angehängt wird.
# Warum: Der Dienst startet dadurch automatisch in der vorgesehenen Betriebsphase.
WantedBy=multi-user.target
