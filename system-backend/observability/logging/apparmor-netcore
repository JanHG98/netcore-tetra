# Included by Ubuntu's rsyslog profile; keeps the existing confinement enabled.
capability net_bind_service,
/etc/netcore/receiver.rsyslog.conf r,
/etc/netcore/syslog.json r,
/etc/netcore/openlab-hosts.json r,
/etc/netcore/log-client.rsyslog.conf r,
/etc/netcore/.log-client-* r,
/{,var/}run/netcore-syslog/** rwk,
/{,var/}run/netcore-log-client/** rwk,
/var/lib/netcore-log-client/ rw,
/var/lib/netcore-log-client/** rwk,
/var/lib/netcore-observability/logs/ rw,
/var/lib/netcore-observability/logs/** rwk,
/opt/netcore-observability/logging/ r,
/opt/netcore-observability/logging/*.py r,
/usr/bin/python3* ixr,
/usr/lib/python3*/** mr,
/usr/local/lib/python3*/** mr,
/{,var/}run/log/journal/** r,
