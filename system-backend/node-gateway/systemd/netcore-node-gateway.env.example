# NETCORE-KOMMENTAR – Was: Enthält einen Teil der Logik für die Verbindung zwischen Basisstationen und Backend-Diensten.
# NETCORE-KOMMENTAR – Warum: Die Trennung in eine eigene Datei macht Zuständigkeit, Wartung und Fehlersuche übersichtlicher.

# TBS ingress credential. Configure the same value as auth_token/token in each
# TBS [control_room] section that points to the Node Gateway.
# Was: Setzt `NETCORE_NODE_GATEWAY_NODE_TOKEN` im Abschnitt `Konfiguration`.
# Warum: Der Wert wird ausdrücklich festgelegt, damit der Dienst auf jedem System gleich und nachvollziehbar arbeitet.
NETCORE_NODE_GATEWAY_NODE_TOKEN=replace-with-long-random-node-token

# WebUI/API roles. Use different random values.
# Was: Setzt `NETCORE_NODE_GATEWAY_VIEWER_TOKEN` im Abschnitt `Konfiguration`.
# Warum: Der Wert wird ausdrücklich festgelegt, damit der Dienst auf jedem System gleich und nachvollziehbar arbeitet.
NETCORE_NODE_GATEWAY_VIEWER_TOKEN=replace-with-viewer-token
# Was: Setzt `NETCORE_NODE_GATEWAY_OPERATOR_TOKEN` im Abschnitt `Konfiguration`.
# Warum: Der Wert wird ausdrücklich festgelegt, damit der Dienst auf jedem System gleich und nachvollziehbar arbeitet.
NETCORE_NODE_GATEWAY_OPERATOR_TOKEN=replace-with-operator-token
# Was: Setzt `NETCORE_NODE_GATEWAY_ADMIN_TOKEN` im Abschnitt `Konfiguration`.
# Warum: Der Wert wird ausdrücklich festgelegt, damit der Dienst auf jedem System gleich und nachvollziehbar arbeitet.
NETCORE_NODE_GATEWAY_ADMIN_TOKEN=replace-with-admin-token

# Credential used by the gateway when bridging each node session to the current
# Control Room. This must match the Control Room node token.
# Was: Setzt `NETCORE_NODE_GATEWAY_UPSTREAM_TOKEN` im Abschnitt `Konfiguration`.
# Warum: Der Wert wird ausdrücklich festgelegt, damit der Dienst auf jedem System gleich und nachvollziehbar arbeitet.
NETCORE_NODE_GATEWAY_UPSTREAM_TOKEN=replace-with-control-room-node-token

# Was: Setzt `RUST_LOG` im Abschnitt `Konfiguration`.
# Warum: Der Wert wird ausdrücklich festgelegt, damit der Dienst auf jedem System gleich und nachvollziehbar arbeitet.
RUST_LOG=info,netcore_node_gateway=debug
