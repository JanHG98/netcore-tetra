[Unit]
Description=NetCore Provisioning Core
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=netcore
Group=netcore
ExecStart=/usr/local/bin/netcore-provisioning-core --config /etc/netcore/provisioning-core.toml
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/netcore-provisioning-core
Environment=RUST_LOG=netcore_provisioning_core=info

[Install]
WantedBy=multi-user.target
