[Unit]
Description=NetCore-TETRA local TBS SIP failover controller
After=network-online.target asterisk.service
Wants=network-online.target
Requires=asterisk.service

[Service]
Type=simple
ExecStart=/usr/local/bin/netcore-tbs-sip-fallback --config /etc/netcore/tbs-sip-fallback.toml --watch
Restart=always
RestartSec=2
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/etc/asterisk /var/lib/netcore-tbs-sip-fallback /run

[Install]
WantedBy=multi-user.target
