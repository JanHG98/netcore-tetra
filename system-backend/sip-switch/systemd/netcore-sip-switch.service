[Unit]
Description=NetCore-TETRA SIP Switch (OPEN LAB MODE)
After=network-online.target asterisk.service
Wants=network-online.target asterisk.service

[Service]
Type=simple
ExecStart=/usr/local/bin/netcore-sip-switch --config /etc/netcore/sip-switch.toml
Restart=on-failure
RestartSec=2
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/netcore-sip-switch /etc/asterisk
ProtectHome=true

[Install]
WantedBy=multi-user.target
