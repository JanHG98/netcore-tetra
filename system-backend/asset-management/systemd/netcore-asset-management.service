[Unit]
Description=NetCore-TETRA Asset Management (OPEN LAB MODE)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/local/bin/netcore-asset-management --config /etc/netcore/asset-management.toml
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/netcore-asset-management

[Install]
WantedBy=multi-user.target
