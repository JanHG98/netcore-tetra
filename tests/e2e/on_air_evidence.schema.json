{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://netcore-tetra.local/schemas/on-air-evidence-v1.json",
  "title": "NetCore-Tetra On-Air Validation Evidence",
  "type": "object",
  "required": ["schema_version", "run_id", "started_at", "finished_at", "site", "network", "devices", "tests"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "site": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "notes": {"type": "string"}
      },
      "additionalProperties": true
    },
    "network": {
      "type": "object",
      "required": ["mcc", "mnc", "main_carrier", "colour_code"],
      "properties": {
        "mcc": {"type": "integer", "minimum": 0, "maximum": 1023},
        "mnc": {"type": "integer", "minimum": 0, "maximum": 16383},
        "main_carrier": {"type": "integer", "minimum": 0},
        "secondary_carrier": {"type": ["integer", "null"], "minimum": 0},
        "colour_code": {"type": "integer", "minimum": 0, "maximum": 63},
        "location_area": {"type": "integer", "minimum": 0, "maximum": 16383}
      },
      "additionalProperties": true
    },
    "devices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["vendor", "model", "issi", "firmware"],
        "properties": {
          "vendor": {"type": "string", "minLength": 1},
          "model": {"type": "string", "minLength": 1},
          "serial": {"type": "string"},
          "firmware": {"type": "string", "minLength": 1},
          "issi": {"type": "integer", "minimum": 1, "maximum": 16777215},
          "notes": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "result", "observed_at"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "result": {"enum": ["passed", "failed", "blocked", "not_run"]},
          "observed_at": {"type": "string", "format": "date-time"},
          "devices": {"type": "array", "items": {"type": "integer", "minimum": 1, "maximum": 16777215}},
          "expected": {"type": "string"},
          "observed": {"type": "string"},
          "notes": {"type": "string"},
          "artifacts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["path", "sha256"],
              "properties": {
                "path": {"type": "string", "minLength": 1},
                "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "description": {"type": "string"}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
